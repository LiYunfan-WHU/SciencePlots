# 中文学位论文（博士）绘图规范（thesis-cn-doctor.mplstyle）
#
# 使用方式（在 science + no-latex 基础上叠加）：
#   plt.style.use(["science", "no-latex", "thesis-cn-doctor"])
#
# 来源：本样式由博士学位论文项目（钼氧化物半导体双光子纳米打印及其光电探测芯片研究）
# 的项目内样式移植而来，保持其原有参数不变：
#   - 字体：无衬线，中文优先思源黑体（Noto Sans CJK SC / Source Han Sans SC），
#           回退微软雅黑，拉丁回退 Arial / DejaVu Sans
#   - 中文负号正常显示
#   - 导出 300 dpi（该项目的既定选择，与硕士样式 600 dpi 不同）
#   - 数据图默认字号 9 / 标题 10，轴线 0.8，线宽 1.2，带浅网格
#
# 与 thesis-cn-master 的区别：字号更大、线更粗、有网格、导出 300 dpi。

figure.dpi : 150

font.family : sans-serif
font.sans-serif : Noto Sans CJK SC, Source Han Sans SC, Microsoft YaHei, Arial, DejaVu Sans
font.size : 9
axes.titlesize : 10
axes.labelsize : 9
axes.linewidth : 0.8
axes.unicode_minus : False

xtick.labelsize : 8
ytick.labelsize : 8
xtick.direction : in
ytick.direction : in
xtick.major.width : 0.8
ytick.major.width : 0.8

legend.fontsize : 8
legend.frameon : False
lines.linewidth : 1.2
lines.markersize : 4

grid.alpha : 0.2
grid.linewidth : 0.5

savefig.dpi : 300
savefig.bbox : tight
savefig.transparent : False
